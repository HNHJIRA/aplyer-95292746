{
  "manifest_version": 3,
  "name": "Aplyer.ai",
  "version": "1.10.0",
  "description": "Detect supported ATS application questions and prepare to generate tailored answers.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.lovable.app/*",
    "https://aplyer.devssh.xyz/*",
    "https://*.greenhouse.io/*",
    "https://boards.greenhouse.io/*",
    "https://job-boards.greenhouse.io/*",
    "https://*.lever.co/*",
    "https://jobs.lever.co/*",
    "https://*.myworkdayjobs.com/*",
    "https://*.workday.com/*",
    "https://*.myworkdaysite.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://boards.greenhouse.io/*",
        "https://job-boards.greenhouse.io/*",
        "https://*.greenhouse.io/*",
        "https://jobs.lever.co/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workday.com/*",
        "https://*.myworkdaysite.com/*"
      ],
      "js": [
        "content/logger.js",
        "content/fill.js",
        "content/adapters/base.js",
        "content/adapters/greenhouse.js",
        "content/adapters/lever.js",
        "content/adapters/workday.js",
        "content/detector.js",
        "content/injector.js",
        "content/autofill.js",
        "content/content.js"
      ],
      "css": [
        "content/inject.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icon.png"
      ],
      "matches": [
        "https://*.greenhouse.io/*",
        "https://*.lever.co/*",
        "https://*.myworkdayjobs.com/*",
        "https://*.workday.com/*",
        "https://*.myworkdaysite.com/*"
      ]
    }
  ],
  "externally_connectable": {
    "matches": [
      "https://aplyer.devssh.xyz/*",
      "https://*.lovable.app/*",
      "http://localhost/*",
      "http://localhost:*/*"
    ]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}