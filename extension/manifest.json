{
  "manifest_version": 3,
  "name": "Aplyer.ai",
  "version": "1.0.0",
  "description": "Stop skipping jobs. Apply and sound like yourself on every application.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
