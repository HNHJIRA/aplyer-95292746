{
  "manifest_version": 3,
  "name": "Aplyer.ai",
  "version": "1.0.0",
  "description": "Stop skipping jobs. Apply and sound like yourself on every application.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://*.lovable.app/*", "https://aplyer.assuredtechno.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "externally_connectable": {
    "matches": [
      "https://aplyer.assuredtechno.com/*",
      "https://*.lovable.app/*",
      "http://localhost/*",
      "http://localhost:*/*"
    ]
  }
}
